{
  "name": "henhouse",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "powershell -ExecutionPolicy Bypass -File ./dev-local.ps1",
    "bots": "node tools/bots/index.mjs",
    "validate:jev": "node tools/jev-validation/index.mjs",
    "experiment:jev:english": "npm --prefix functions run build && node tools/jev-validation/scenarios/english-experiment.mjs",
    "test:jev:english": "node --test tools/jev-validation/tests/english-evaluation.test.mjs",
    "replay:jev:english": "node tools/jev-validation/scenarios/english-replay.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "firebase": "^12.11.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "15.32.1",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
